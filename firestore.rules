rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Committee Members collection - only authenticated user can access their own document
    match /CommitteeMembers/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
      
      // Cash Submissions subcollection
      match /Submissions/{submissionId} {
        allow read: if request.auth != null && request.auth.token.email == email;
        allow create: if request.auth != null && request.auth.token.email == email;
        allow update, delete: if request.auth != null && request.auth.token.email == email;
      }
      
      // In-Kind Donations subcollection
      match /InKindDonations/{donationId} {
        allow read: if request.auth != null && request.auth.token.email == email;
        allow create: if request.auth != null && request.auth.token.email == email;
        allow update, delete: if request.auth != null && request.auth.token.email == email;
      }
    }
  }
}
